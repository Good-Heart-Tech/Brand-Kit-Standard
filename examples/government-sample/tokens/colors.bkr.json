{
  "$schema": "https://cdn.jsdelivr.net/gh/Good-Heart-Tech/Brand-Kit-Standard@main/packages/bkr-schema/schemas/bkr-token.schema.json",
  "meta": {
    "brandId": "brightwater-county",
    "layer": "color"
  },
  "tokens": {
    "palette": {
      "primary": {
        "value": "#1B4F8A",
        "type": "color",
        "description": "Civic blue. Buttons, the page header bar, and the logo.",
        "usage": { "contexts": ["buttons", "header bar", "focus rings", "logo"], "avoid": ["body text", "large page backgrounds"] }
      },
      "onPrimary": {
        "value": "#FFFFFF",
        "type": "color",
        "description": "White labels and icons on civic blue buttons and green success messages."
      },
      "link": {
        "value": "#1A5DAB",
        "type": "color",
        "description": "Text links on the page and on cards. Always underlined.",
        "usage": { "contexts": ["text links"], "avoid": ["button backgrounds"] }
      },
      "ink": {
        "value": "#0B1F33",
        "type": "color",
        "description": "Headings and high-contrast text."
      },
      "body": {
        "value": "#2B3A4A",
        "type": "color",
        "description": "Paragraph and form text."
      },
      "surface": {
        "value": "#FFFFFF",
        "type": "color",
        "description": "Page background."
      },
      "subtle": {
        "value": "#EAF2FA",
        "type": "color",
        "description": "Light blue wash for cards, service tiles, and table stripes.",
        "usage": { "contexts": ["cards", "service tiles", "table stripes"], "avoid": ["text"] }
      },
      "success": {
        "value": "#2E7D4F",
        "type": "color",
        "description": "Brightwater green. Success messages, park maps, and accents.",
        "usage": { "contexts": ["success messages", "confirmation banners", "maps and charts"], "avoid": ["meaning shown by color alone"] }
      },
      "alert": {
        "value": "#F2B632",
        "type": "color",
        "description": "Alert gold. Background of emergency and warning banners, always with onAlert text. Never used as text.",
        "usage": { "contexts": ["emergency alert banners", "warning callouts", "decorative stripes"], "avoid": ["text", "white labels", "buttons"] }
      },
      "onAlert": {
        "value": "#0B1F33",
        "type": "color",
        "description": "Dark text and icons on alert gold. Stays dark in every theme."
      }
    }
  }
}
