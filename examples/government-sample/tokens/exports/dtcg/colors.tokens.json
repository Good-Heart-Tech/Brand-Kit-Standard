{
  "$description": "DTCG export for brightwater-county (tokens/colors.obks.json). Generated by obks export. Do not edit by hand.",
  "palette": {
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1059,
          0.3098,
          0.5412
        ],
        "hex": "#1b4f8a"
      },
      "$description": "Civic blue. Buttons, the page header bar, and the logo.",
      "$extensions": {
        "obks": {
          "usage": {
            "contexts": [
              "buttons",
              "header bar",
              "focus rings",
              "logo"
            ],
            "avoid": [
              "body text",
              "large page backgrounds"
            ]
          }
        }
      }
    },
    "onPrimary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      },
      "$description": "White labels and icons on civic blue buttons and green success messages."
    },
    "link": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.102,
          0.3647,
          0.6706
        ],
        "hex": "#1a5dab"
      },
      "$description": "Text links on the page and on cards. Always underlined.",
      "$extensions": {
        "obks": {
          "usage": {
            "contexts": [
              "text links"
            ],
            "avoid": [
              "button backgrounds"
            ]
          }
        }
      }
    },
    "ink": {
