{
  "$schema": "https://cdn.jsdelivr.net/gh/Good-Heart-Tech/Open-Brand-Kit-Standard@main/packages/obks-schema/schemas/obks-token.schema.json",
  "meta": {
    "brandId": "acme-labs",
    "layer": "color"
  },
  "tokens": {
    "palette": {
      "primary": {
        "value": "#2563EB",
        "type": "color",
        "description": "Acme blue. Buttons and key actions.",
        "usage": { "contexts": ["buttons", "active states", "focus rings"], "avoid": ["large background fills"] }
      },
      "onPrimary": {
        "value": "#FFFFFF",
        "type": "color",
        "description": "Labels and icons on primary."
      },
      "link": {
        "value": "#1D4ED8",
        "type": "color",
        "description": "Text links on the page background."
      },
      "ink": {
        "value": "#0F172A",
        "type": "color",
        "description": "Headings and high-contrast text."
      },
      "body": {
        "value": "#334155",
        "type": "color",
        "description": "Body text."
      },
      "surface": {
        "value": "#FFFFFF",
        "type": "color",
        "description": "Page background."
      },
      "subtle": {
        "value": "#EFF6FF",
        "type": "color",
        "description": "Callout panels and table stripes."
      },
      "accent": {
        "value": "#38BDF8",
        "type": "color",
        "description": "Illustrations and highlights only.",
        "usage": { "contexts": ["illustrations", "charts"], "avoid": ["text", "buttons"] }
      }
    }
  }
}
