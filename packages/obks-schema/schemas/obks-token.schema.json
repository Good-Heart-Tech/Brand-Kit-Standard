{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cdn.jsdelivr.net/gh/Good-Heart-Tech/Open-Brand-Kit-Standard@main/packages/obks-schema/schemas/obks-token.schema.json",
  "title": "OBKS token document",
  "description": "A tokens/*.obks.json file. Value formats per type are checked by obks validate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "tokens"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brandId", "layer"],
      "properties": {
        "brandId": { "type": "string", "minLength": 1 },
        "layer": { "enum": ["color", "typography", "spacing", "motion", "theme"] }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "doNotUse": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tokens": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": { "$ref": "#/$defs/token" }
      }
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "type"],
      "properties": {
        "value": {
          "description": "color: #RRGGBB. dimension: 16px or 1rem. duration: 200ms. fontFamily: string or list. fontWeight/number: number.",
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          ]
        },
        "type": {
          "enum": ["color", "dimension", "fontFamily", "fontWeight", "duration", "number", "string"]
        },
        "description": { "type": "string" },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contexts": { "type": "array", "items": { "type": "string" } },
            "avoid": { "type": "array", "items": { "type": "string" } }
          }
        },
        "aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["value"],
            "properties": {
              "value": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "inheritsFrom": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+\\.[a-zA-Z0-9_-]+$",
          "description": "Product kits: the parent token path (group.name) this value is locked to."
        }
      }
    }
  }
}
