{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://good-heart-tech.github.io/Brand-Kit-Standard/schemas/v1/brandkit.schema.json",
  "title": "BKR brandkit manifest",
  "description": "brandkit.yaml for a Brand Kit Repository (ght.brandkit/v1). See spec/BKR-SPEC.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "specVersion", "brand", "role", "profiles", "consumption"],
  "properties": {
    "schema": { "const": "ght.brandkit/v1" },
    "specVersion": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$",
      "description": "Spec version this kit follows, for example 0.2.0."
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$",
          "description": "Lowercase, hyphenated id, for example good-heart-tech."
        },
        "displayName": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "active", "deprecated"] }
      }
    },
    "role": { "enum": ["organization", "product", "campaign"] },
    "hierarchy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parent"],
      "properties": {
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "ref", "brandId"],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "ref": { "type": "string", "minLength": 1 },
            "brandId": { "type": "string", "minLength": 1 },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Optional local path to a checkout of the parent kit, used by bkr validate to check inherited tokens."
            }
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core"],
      "properties": {
        "core": { "const": true },
        "identity": { "type": "boolean" },
        "voice": { "type": "boolean" },
        "visual": { "type": "boolean" },
        "copy": { "type": "boolean" },
        "tokens": { "type": "boolean" },
        "security": { "type": "boolean" },
        "partnerPublic": {
          "type": "boolean",
          "deprecated": true,
          "description": "Deprecated in 0.2. Use publication.visibility."
        }
      }
    },
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cssVariables", "agentDigest"],
      "properties": {
        "cssVariables": { "type": "string", "minLength": 1 },
        "agentDigest": { "type": "string", "minLength": 1 },
        "tailwindTheme": { "type": "string" },
        "cssPrefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Prefix for CSS variables. Defaults to brand.id without hyphens."
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional. Which color token plays each part on the generated sample page. Inferred from contrastPairs and common names when left out.",
      "properties": {
        "surface": { "type": "string" },
        "text": { "type": "string" },
        "heading": { "type": "string" },
        "link": { "type": "string" },
        "buttonBg": { "type": "string" },
        "buttonText": { "type": "string" },
        "card": { "type": "string" },
        "accent": { "type": "string" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visibility": {
          "enum": ["private", "partner", "public"],
          "default": "private",
          "description": "What may leave the organization. private: nothing. partner: includedPaths for approved partners. public: includedPaths for anyone."
        },
        "includedPaths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files or folders that bkr publish may bundle when visibility is partner or public."
        },
        "allowExternalMirror": {
          "type": "boolean",
          "deprecated": true,
          "description": "Deprecated in 0.2. Use visibility: public."
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rulesPack": {
          "type": "string",
          "description": "npm package name or local path (./rules/index.js) exporting validate()."
        },
        "minContrastRatio": { "type": "number", "minimum": 1, "maximum": 21 },
        "contrastPairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["foreground", "background"],
            "properties": {
              "foreground": { "type": "string", "description": "Token path, for example palette.body" },
              "background": { "type": "string", "description": "Token path, for example palette.surface" },
              "use": { "type": "string" },
              "min": { "type": "number", "minimum": 1, "maximum": 21 }
            }
          }
        },
        "avoidPairs": {
          "type": "array",
          "description": "Color combinations people should not use. Shown as the Don't column next to contrastPairs.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["foreground", "background", "reason"],
            "properties": {
              "foreground": { "type": "string" },
              "background": { "type": "string" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "contacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": { "type": "string", "format": "email" },
        "legal": { "type": "string", "format": "email" },
        "security": {
          "type": "string",
          "anyOf": [{ "format": "uri", "pattern": "^https://" }, { "format": "email" }],
          "description": "Optional. Where people report impersonation. Prefer a URL (website contact page or /.well-known/security.txt) so no email address is stored in the kit."
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "role": { "const": "product" } }, "required": ["role"] },
      "then": { "required": ["hierarchy"] }
    }
  ]
}
