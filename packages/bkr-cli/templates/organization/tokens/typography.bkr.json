{
  "$schema": "https://cdn.jsdelivr.net/gh/Good-Heart-Tech/Brand-Kit-Standard@main/packages/bkr-schema/schemas/bkr-token.schema.json",
  "meta": {
    "brandId": "{{brandId}}",
    "layer": "typography"
  },
  "tokens": {
    "fontFamily": {
      "heading": {
        "value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
        "type": "fontFamily",
        "description": "Headings. Replace with your brand font."
      },
      "body": {
        "value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
        "type": "fontFamily",
        "description": "Paragraphs and UI text."
      }
    },
    "fontWeight": {
      "regular": { "value": 400, "type": "fontWeight" },
      "bold": { "value": 700, "type": "fontWeight" }
    },
    "fontSize": {
      "small": { "value": "0.875rem", "type": "dimension" },
      "base": { "value": "1rem", "type": "dimension" },
      "large": { "value": "1.25rem", "type": "dimension" },
      "heading": { "value": "2rem", "type": "dimension" }
    }
  }
}
