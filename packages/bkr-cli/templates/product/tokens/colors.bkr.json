{
  "$schema": "https://cdn.jsdelivr.net/gh/Good-Heart-Tech/Brand-Kit-Standard@main/packages/bkr-schema/schemas/bkr-token.schema.json",
  "meta": {
    "brandId": "{{brandId}}",
    "layer": "color"
  },
  "tokens": {
    "palette": {
      "primary": {
        "value": "#2563EB",
        "type": "color",
        "inheritsFrom": "palette.primary",
        "description": "Locked to the parent primary. Change it in the parent kit, not here."
      },
      "onPrimary": {
        "value": "#FFFFFF",
        "type": "color",
        "inheritsFrom": "palette.onPrimary",
        "description": "Button labels on primary."
      },
      "ink": {
        "value": "#0F172A",
        "type": "color",
        "inheritsFrom": "palette.ink",
        "description": "Headings and text."
      },
      "surface": {
        "value": "#FFFFFF",
        "type": "color",
        "inheritsFrom": "palette.surface",
        "description": "Page background."
      },
      "productAccent": {
        "value": "#7C3AED",
        "type": "color",
        "description": "Program-only accent for highlight bands. Not for text or buttons.",
        "usage": { "contexts": ["highlight bands", "illustrations"], "avoid": ["body text", "buttons"] }
      }
    }
  }
}
